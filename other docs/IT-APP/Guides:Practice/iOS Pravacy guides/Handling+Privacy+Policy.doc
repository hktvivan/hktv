<ul>
<li>
<p><a class=3D"external-link" data-card-appearance=3D"inline" href=3D"https=
://developer.apple.com/support/third-party-SDK-requirements/" rel=3D"nofoll=
ow">https://developer.apple.com/support/third-party-SDK-requirements/</a></=
p></li>
<li>
<p><a class=3D"external-link" data-card-appearance=3D"inline" href=3D"https=
://developer.apple.com/documentation/bundleresources/privacy_manifest_files=
#4284009" rel=3D"nofollow">https://developer.apple.com/documentation/bundle=
resources/privacy_manifest_files#4284009</a></p></li>
<li>
<p><a class=3D"external-link" data-card-appearance=3D"inline" href=3D"https=
://developer.apple.com/documentation/bundleresources/privacy_manifest_files=
/describing_data_use_in_privacy_manifests" rel=3D"nofollow">https://develop=
er.apple.com/documentation/bundleresources/privacy_manifest_files/describin=
g_data_use_in_privacy_manifests</a></p></li>
<li>
<p><a class=3D"external-link" href=3D"https://developer.apple.com/documenta=
tion/bundleresources/privacy_manifest_files/describing_use_of_required_reas=
on_api" rel=3D"nofollow">https://developer.apple.com/documentation/bundlere=
sources/privacy_manifest_files/describing_use_of_required_reason_api</a></p=
></li>
<li>
<p><a class=3D"external-link" data-card-appearance=3D"inline" href=3D"https=
://developer.apple.com/videos/play/wwdc2023/10060/" rel=3D"nofollow">https:=
//developer.apple.com/videos/play/wwdc2023/10060/</a></p></li>
<li>
<p><a class=3D"external-link" data-card-appearance=3D"inline" href=3D"https=
://developer.apple.com/videos/play/wwdc2023/10061/" rel=3D"nofollow">https:=
//developer.apple.com/videos/play/wwdc2023/10061/</a></p></li>
<li>
<p><a class=3D"external-link" data-card-appearance=3D"inline" href=3D"https=
://developer.apple.com/forums/thread/733537" rel=3D"nofollow">https://devel=
oper.apple.com/forums/thread/733537</a></p></li>
<li>
<p><a class=3D"external-link" data-card-appearance=3D"inline" href=3D"https=
://github.com/Alamofire/Alamofire/pull/3792" rel=3D"nofollow">https://githu=
b.com/Alamofire/Alamofire/pull/3792</a></p></li>
</ul>
    </div>
</body>
</html>
