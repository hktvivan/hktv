<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: java; gutter: false; theme: Confluence" data-theme=3D"Confluence">import =
UIKit

extension UIScrollView {
    func shouldStartLoadMore(scrollView: UIScrollView) -&gt; Bool {
        let offset =3D scrollView.contentOffset
        let bounds =3D scrollView.bounds
        let size =3D scrollView.contentSize
        let inset =3D scrollView.contentInset
       =20
        let inViewScrollViewHeight =3D bounds.size.height - inset.bottom
        let contentHeight =3D size.height
       =20
        // Find 500 pixels in defferent device
        let fixedSizeInPoints: CGFloat =3D 500.0
        let scale =3D UIScreen.main.scale
        let fixedSizeInPixels =3D fixedSizeInPoints * scale

        let reloadDistance:CGFloat =3D fixedSizeInPixels
       =20
        // =E5=85=A7=E5=AE=B9=E9=AB=98=E5=BA=A6 - =E6=BB=91=E5=8B=95=E4=BD=
=8D=E7=A7=BB &lt; =E7=95=AB=E9=9D=A2=E5=8F=AF=E8=A6=96=E7=AF=84=E5=9C=8D + =
=E9=A0=90=E8=A8=AD=E8=A7=B8=E7=99=BC=E8=B7=9D=E9=9B=A2
        return contentHeight - offset.y &lt; inViewScrollViewHeight + reloa=
dDistance
    }
}
</pre>
