s://www.npmjs.com/package/nodemon</a></p></li>
</ul>
<h1 id=3D"WebViewredirecttesting-=E5=BB=BA=E7=AB=8BServer">=E5=BB=BA=E7=AB=
=8BServer</h1>
<ol start=3D"1">
<li>
<p>init project</p></li>
</ol>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: java; gutter: false; theme: Confluence" data-theme=3D"Confluence">npm ini=
t -y</pre>
</div>
</div>
<ol start=3D"2">
<li>
<p>install <code>express</code></p></li>
</ol>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: java; gutter: false; theme: Confluence" data-theme=3D"Confluence">npm ins=
tall express</pre>
</div>
</div>
<ol start=3D"3">
<li>
<p>create server file <code>server.js</code>; add redirect code</p></li>
</ol>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: js; gutter: false; theme: Confluence" data-theme=3D"Confluence">const exp=
ress =3D require("express");
const app =3D express();

// =E5=85=A9=E7=A8=AERedirect=E6=96=B9=E5=BC=8F, =E6=93=87=E4=B8=80=E4=BD=
=BF=E7=94=A8
app.get("/", (req, res) =3D&gt; {
 =20
  // 1. Send JavaScript code to change window location
  const jsCode =3D `
     &lt;script&gt;
       window.location.href =3D "https://thirty-coins-shine.loca.lt/redirec=
t";
     &lt;/script&gt;
  `;
  // Send the JavaScript code as response
  res.send(jsCode);

  // 2. Redirect with 302
  res.redirect(302, "https://thirty-coins-shine.loca.lt/redirect");
});

// Start the server
const port =3D 8000;
app.listen(port, () =3D&gt; {
  console.log(`Server is running on http://localhost:${port}`);
});</pre>
</div>
</div>
<ol start=3D"4">
<li>
<p>Start server</p></li>
</ol>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: java; gutter: false; theme: Confluence" data-theme=3D"Confluence">node se=
rver.js
or
nodemon server.js</pre>
</div>
</div>
<ol start=3D"5">
<li>
<p>Use<code>localtunnel, public local server with https</code></p></li>
</ol>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: java; gutter: false; theme: Confluence" data-theme=3D"Confluence">lt --po=
rt 8000 // port=E8=88=87server=E7=9B=B8=E5=90=8C

// output
your url is: https://huge-parks-wish.loca.lt (=E6=AF=8F=E6=AC=A1reload, url=
=E9=83=BD=E6=9C=83=E6=94=B9=E8=AE=8A)</pre>
</div>
</div>
