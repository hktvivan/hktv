# Slack: create an app, enable Socket Mode, install to workspace, copy tokens from API dashboard.
# https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...

# Comma- or semicolon-separated absolute roots; resolved paths must stay under one of them.
# Example (Windows): C:\Users\You\Documents\Dev
ALLOWLIST_ROOTS=C:\Users\You\Documents\cursor-project

# Required: only these Slack user IDs can invoke the bridge (e.g. U0ABC1234).
# Empty means deny all — set at least one.
ALLOWED_SLACK_USER_IDS=U12345

# Optional: if set, only these channel IDs (e.g. C0ABC) are allowed.
# Leave empty to allow all channels the bot is in.
# ALLOWED_SLACK_CHANNEL_IDS=

# Optional: path to a JSON file mapping WORKSPACE_ALIAS keys to relative paths
# (under the first allowlist root) or absolute paths that still pass the allowlist check.
# See config/workspaces.example.json
# WORKSPACES_JSON=config/workspaces.json

# Strongly recommended on Windows if you see: 'agent' is not recognized:
# (Run: dir $env:USERPROFILE\.local\bin\agent* after: irm https://cursor.com/install?win32=true | iex)
# CURSOR_AGENT_CMD=C:\Users\You\.local\bin\agent.exe

# Optional: 0 = no timeout; e.g. 1200000 = 20 minutes.
# AGENT_TIMEOUT_MS=0

# Default: project/.cursor-bridge/agent-logs
# BRIDGE_LOG_DIR=

# Default: project/.cursor-bridge/audit.log
# AUDIT_LOG_FILE=

# Bolt HTTP port; Socket Mode still uses 0 in many setups. Default 0.
# PORT=0

# SLACK_LOG_LEVEL=INFO
